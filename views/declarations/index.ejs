<%- include('../partials/header') %>

<style>
    /* Optimisation pour l'impression / PDF */
    @media print {
        .no-print { display: none !important; }
        body { background-color: #fff !important; font-size: 11pt; }
        .card { border: 1px solid #ced4da !important; box-shadow: none !important; margin-bottom: 1rem !important; }
        .container-fluid { width: 100% !important; padding: 0 !important; }
        .table-responsive { overflow: visible !important; }
        .badge { border: 1px solid #000; color: #000 !important; background: transparent !important; }
    }

    .kpi-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
    }
    
    .kpi-divider {
        border-bottom: 1px solid #e9ecef;
    }
    @media (min-width: 768px) {
        .kpi-divider {
            border-bottom: none;
            border-right: 1px solid #e9ecef;
        }
    }
    
    .font-monospace-sm {
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        letter-spacing: 0.5px;
    }
</style>

<main class="container-fluid px-2 px-md-4 my-3 my-md-4">
    <!-- Barre d'actions supérieure -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom no-print">
        <div>
            <h2 class="h4 fw-bold mb-1 text-dark">
                <i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Portail des Déclarations Légales & Fiscale (Algérie)
            </h2>
            <p class="text-muted mb-0 small">Gestion centralisée : DAS (CNAS) — G50 (IRG) — Bordereau Mensuel CNAS</p>
        </div>
        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
            <a href="/declarations/export-das-employeur" class="btn btn-outline-primary btn-sm flex-fill flex-md-grow-0 fw-semibold">
                <i class="fa-solid fa-building me-1"></i> DAS Employeur (.txt)
            </a>
            <a href="/declarations/export-das-salaries" class="btn btn-outline-success btn-sm flex-fill flex-md-grow-0 fw-semibold">
                <i class="fa-solid fa-users me-1"></i> DAS Salariés (.txt)
            </a>
            <button onclick="window.print();" class="btn btn-primary btn-sm flex-fill flex-md-grow-0 fw-semibold">
                <i class="fa-solid fa-print me-1"></i> Imprimer / PDF
            </button>
        </div>
    </div>

    <!-- En-tête Administratif Employeur & Organismes -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm p-3 h-100 bg-body rounded-3 border-start border-primary border-4">
                <h6 class="text-primary fw-bold text-uppercase small mb-3">
                    <i class="fa-solid fa-building-user me-2"></i>Identification de l'Employeur
                </h6>
                <div class="row g-2 small">
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">Raison Sociale</span>
                        <strong class="text-dark"><%= company.name %></strong>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">N° Sécurité Sociale (CNAS)</span>
                        <span class="badge bg-dark font-monospace-sm"><%= company.cnasNo %></span>
                    </div>
                    <div class="col-12">
                        <span class="text-muted d-block">Adresse Réelle</span>
                        <span class="text-dark"><%= company.address %></span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">NIF</span>
                        <span class="font-monospace-sm text-dark"><%= company.nif %></span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">Registre du Commerce (RC)</span>
                        <span class="font-monospace-sm text-dark"><%= company.rc %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm p-3 h-100 bg-body rounded-3 border-start border-success border-4">
                <h6 class="text-success fw-bold text-uppercase small mb-3">
                    <i class="fa-solid fa-landmark me-2"></i>Organismes Fiscaux & Sociaux
                </h6>
                <div class="row g-2 small">
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">Recette des Impôts (G50)</span>
                        <strong class="text-dark"><%= company.centreImpots %></strong>
                    </div>
                    <div class="col-12 col-sm-6">
                        <span class="text-muted d-block">Agence CNAS</span>
                        <strong class="text-dark"><%= company.agenceCnas %></strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Effectif Actif</span>
                        <span class="badge bg-info text-dark rounded-pill"><%= declaration.totalEmployees %> Salarié(s)</span>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block">Période Calculée</span>
                        <span class="badge bg-success rounded-pill"><%= declaration.periodeMois %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 1 : DÉCLARATION MENSUELLE G50 (IRG) -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden kpi-card">
        <div class="card-header bg-primary text-white py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-bold"><i class="fa-solid fa-receipt me-2"></i>Déclaration Mensuelle G50 — Volet IRG / Traitements et Salaires</h6>
            <span class="badge bg-white text-primary fw-semibold">Échéance : 20 du mois M+1</span>
        </div>
        <div class="card-body p-3">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-7 col-lg-8">
                    <p class="text-muted mb-2 small">
                        Impôt sur le Revenu Global (IRG) retenu à la source sur les salaires du mois de 
                        <strong class="text-dark"><%= declaration.periodeMois %></strong> :
                    </p>
                    <ul class="mb-0 text-secondary small ps-3">
                        <li>Masse Salariale Mensuelle Soumise : 
                            <strong class="text-dark">
                                <%= Number(declaration.masseSalarialeMensuelle).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                            </strong>
                        </li>
                        <li>Barème officiel IRG (Article 104 du CIDTA) appliqué.</li>
                    </ul>
                </div>
                <div class="col-12 col-md-5 col-lg-4 text-start text-md-end bg-light p-3 rounded-3">
                    <span class="text-muted small d-block mb-1 font-monospace">Montant IRG à Verser (G50)</span>
                    <h3 class="fw-bold text-primary mb-0 fs-4 font-monospace">
                        <%= Number(declaration.irgMensuel).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2 : BORDEREAU MENSUEL DES COTISATIONS (BMC - CNAS 35%) -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden kpi-card">
        <div class="card-header bg-success text-white py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-bold"><i class="fa-solid fa-shield-halved me-2"></i>Bordereau Mensuel des Cotisations (BMC — CNAS)</h6>
            <span class="badge bg-white text-success fw-semibold">Échéance : 15 du mois M+1</span>
        </div>
        <div class="card-body p-3">
            <div class="row text-center g-3">
                <div class="col-12 col-md-4 kpi-divider pb-3 pb-md-0">
                    <span class="text-muted small d-block mb-1">Cotisation Salariale (9%)</span>
                    <h4 class="fw-bold text-dark fs-5 mb-0 font-monospace">
                        <%= Number(declaration.cnasSalarialeMensuelle).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h4>
                </div>
                <div class="col-12 col-md-4 kpi-divider pb-3 pb-md-0">
                    <span class="text-muted small d-block mb-1">Cotisation Patronale (26%)</span>
                    <h4 class="fw-bold text-dark fs-5 mb-0 font-monospace">
                        <%= Number(declaration.cnasPatronaleMensuelle).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h4>
                </div>
                <div class="col-12 col-md-4">
                    <span class="text-muted small d-block mb-1">Total Cotisations CNAS (35%)</span>
                    <h4 class="fw-bold text-success fs-5 mb-0 font-monospace">
                        <%= Number(declaration.totalCnasMensuel).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 3 : DÉCLARATION ANNUELLE DES SALAIRES (DAS) -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden kpi-card">
        <div class="card-header bg-dark text-white py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h6 class="mb-0 fw-bold"><i class="fa-solid fa-file-shield me-2"></i>Récapitulatif Annuel — DAS (Exercice <%= declaration.periodeAnnee %>)</h6>
            <span class="badge bg-secondary text-white fw-semibold">Dépôt Annuel Avant 31 Janvier</span>
        </div>
        <div class="card-body p-3">
            <div class="row text-center g-3 align-items-center">
                <div class="col-12 col-md-4 kpi-divider pb-3 pb-md-0">
                    <span class="text-muted small d-block mb-1">Masse Salariale Cumulée (Brut)</span>
                    <h4 class="fw-bold text-primary fs-5 mb-0 font-monospace">
                        <%= Number(declaration.masseSalarialeTotale).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h4>
                </div>
                <div class="col-12 col-md-4 kpi-divider pb-3 pb-md-0">
                    <span class="text-muted small d-block mb-1">Total CNAS Annuel (35%)</span>
                    <h4 class="fw-bold text-danger fs-5 mb-0 font-monospace">
                        <%= Number(declaration.totalCnasVerserAnnuel).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> DZD
                    </h4>
                </div>
                <div class="col-12 col-md-4">
                    <span class="text-muted small d-block mb-1">Conformité Fichier Plat DAS (.txt)</span>
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill w-100 w-md-auto">
                        <i class="fa-solid fa-check-circle me-1"></i> Format Longueur Fixe Conforme
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau Nominatif Officiel (Détail DAS Salariés) -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
        <div class="card-header bg-light py-3 px-3 d-flex justify-content-between align-items-center border-bottom">
            <h6 class="mb-0 text-dark fw-bold"><i class="fa-solid fa-users-rectangle me-2 text-primary"></i>État Nominatif des Salariés (Détail DAS)</h6>
            <span class="text-muted small d-none d-sm-inline">Norme CNAS à positions fixes</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-dark text-center small">
                        <tr>
                            <th style="width: 40px;">N°</th>
                            <th>N° Sécurité Sociale</th>
                            <th class="text-start">Nom & Prénom</th>
                            <th>Dates (Naiss. / Entrée)</th>
                            <th class="text-start">Emploi / Fonction</th>
                            <th class="text-end">Salaire Soumis (DZD)</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <% if (employeesList && employeesList.length > 0) { %>
                            <% employeesList.forEach((emp, index) => { %>
                                <tr>
                                    <td class="text-center fw-bold text-muted"><%= index + 1 %></td>
                                    <td class="text-center font-monospace-sm"><%= emp.num_ss || 'N/C' %></td>
                                    <td class="fw-bold text-start text-dark"><%= emp.nom %> <%= emp.prenom %></td>
                                    <td class="text-center">
                                        <div class="lh-sm">
                                            <span class="d-block text-muted"><strong>N:</strong> <%= emp.date_naissance_formatted || '-' %></span>
                                            <span class="d-block text-muted"><strong>E:</strong> <%= emp.date_entree_formatted || '-' %></span>
                                        </div>
                                    </td>
                                    <td class="text-start"><%= emp.emploi || '-' %></td>
                                    <td class="text-end fw-bold text-primary font-monospace">
                                        <%= emp.salaire_de_base ? Number(emp.salaire_de_base).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' DZD' : '0,00 DZD' %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Aucun salarié enregistré pour cette période.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>