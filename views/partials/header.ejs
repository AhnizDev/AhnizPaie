<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
    <title>
        <%= typeof title !=='undefined' ? title : 'AhnizPaie | Système de Paie Algérienne — AhniZTech' %>
    </title>
    <meta name="title"
        content="<%= typeof title !== 'undefined' ? title : 'AhnizPaie | Système de Paie Algérienne — AhniZTech' %>">
    <meta name="description"
        content="<%= typeof description !== 'undefined' ? description : 'Logiciel de paie modulaire conforme à la réglementation algérienne. Développé par AhniZTech.' %>">

    <!-- Google Images Link -->
    <link rel="image_src"
        href="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://ahnizdev.github.io/AhnizPaieLogo/AhnizPaieLogo.png' %>">

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="AhnizPaie — Solution RH & Paie">
    <meta property="og:title"
        content="<%= typeof title !== 'undefined' ? title : 'AhnizPaie | Gestion de Paie Algérienne' %>">
    <meta property="og:description"
        content="<%= typeof description !== 'undefined' ? description : 'Logiciel de paie modulaire conforme à la réglementation algérienne. Développé par AhniZTech.' %>">
    <meta property="og:url" content="http://35.180.90.207:3001/">
    <meta property="og:image"
        content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://ahnizdev.github.io/AhnizPaieLogo/AhnizPaieLogo.png' %>">
    <meta property="og:image:secure_url"
        content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://ahnizdev.github.io/AhnizPaieLogo/AhnizPaieLogo.png' %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1024">
    <meta property="og:image:height" content="1024">
    <meta property="og:locale" content="fr_FR">

    <!-- FontAwesome & Bootstrap CSS CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    <header class="app-header">
        <div class="header-container">
            <a href="/dashboard" class="brand-logo">
                <i class="fa-solid fa-calculator"></i> <span>AhnizPaie</span>
            </a>
            <nav class="main-nav">
                <a href="/dashboard" class="nav-link" title="Dashboard">
                    <i class="fa-solid fa-house"></i> <span class="d-none d-md-inline">Dashboard</span>
                </a>
                <a href="/payroll/bulletin" class="nav-link" title="Bulletin">
                    <i class="fa-solid fa-file-invoice-dollar"></i> <span class="d-none d-md-inline">Bulletin</span>
                </a>
                <a href="/logout" class="nav-link text-danger" title="Déconnexion">
                    <i class="fa-solid fa-right-from-bracket"></i> <span class="d-none d-md-inline">Déconnexion</span>
                </a>
            </nav>
        </div>
    </header>