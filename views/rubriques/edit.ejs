<%- include('../partials/header') %>

<main class="container my-3 my-md-4 flex-grow-1" style="max-width: 800px;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 pb-3 border-bottom">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Modifier la Rubrique
            </h2>
            <small class="text-muted">Mise à jour des paramètres de la rubrique #<%= rubrique.code %></small>
        </div>
        <a href="/rubriques" class="btn btn-outline-secondary btn-sm w-100 w-sm-auto">
            <i class="fa-solid fa-arrow-left me-1"></i> Annuler
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">
            <form action="/rubriques/edit/<%= rubrique.id %>" method="POST">
                
                <!-- Code et Libellé -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label for="code" class="form-label fw-bold text-secondary small text-uppercase">Code Rubrique</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-hashtag"></i></span>
                            <input type="number" class="form-control" id="code" name="code" value="<%= rubrique.code %>" required>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <label for="libelle" class="form-label fw-bold text-secondary small text-uppercase">Libellé</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-font"></i></span>
                            <input type="text" class="form-control" id="libelle" name="libelle" value="<%= rubrique.libelle %>" required>
                        </div>
                    </div>
                </div>

                <!-- Type et Taux -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <label for="type_rubrique" class="form-label fw-bold text-secondary small text-uppercase">Type de Rubrique</label>
                        <select class="form-select" id="type_rubrique" name="type_rubrique" required>
                            <option value="gain" <%= rubrique.type_rubrique === 'gain' ? 'selected' : '' %>>Gain (+)</option>
                            <option value="retenue" <%= rubrique.type_rubrique === 'retenue' ? 'selected' : '' %>>Retenue (-)</option>
                            <option value="patronale" <%= rubrique.type_rubrique === 'patronale' ? 'selected' : '' %>>Patronale (Charges)</option>
                            <option value="totaux" <%= rubrique.type_rubrique === 'totaux' ? 'selected' : '' %>>Totaux / Sous-total</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="taux_salarie" class="form-label fw-bold text-secondary small text-uppercase">Taux Salarié (%)</label>
                        <div class="input-group">
                            <input type="number" step="0.001" class="form-control" id="taux_salarie" name="taux_salarie" value="<%= rubrique.taux_salarie %>">
                            <span class="input-group-text bg-light text-muted">%</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <label for="taux_patronal" class="form-label fw-bold text-secondary small text-uppercase">Taux Patronal (%)</label>
                        <div class="input-group">
                            <input type="number" step="0.001" class="form-control" id="taux_patronal" name="taux_patronal" value="<%= rubrique.taux_patronal %>">
                            <span class="input-group-text bg-light text-muted">%</span>
                        </div>
                    </div>
                </div>

                <!-- Boutons d'action responsive -->
                <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 pt-3 border-top">
                    <a href="/rubriques" class="btn btn-light border py-2 px-4 fw-semibold text-center">Annuler</a>
                    <button type="submit" class="btn btn-primary py-2 px-4 fw-semibold shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer
                    </button>
                </div>

            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>