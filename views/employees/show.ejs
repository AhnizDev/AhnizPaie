<%- include('../partials/header') %>

<main class="container my-4 flex-grow-1">
    <!-- En-tête de la fiche -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="h4 font-weight-bold text-dark mb-0">
                <i class="fa-solid fa-id-card me-2 text-primary"></i>Fiche Salarié : <%= employee.nom %> <%= employee.prenom %>
            </h2>
            <small class="text-muted">Matricule : <strong class="text-primary"><%= employee.matricule %></strong></small>
        </div>
        <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
            <a href="/employees" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Retour
            </a>
            <a href="/employees/edit/<%= employee.id %>" class="btn btn-primary">
                <i class="fa-solid fa-pen-to-square me-1"></i> Modifier
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Informations Personnelles -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-0">
                    <i class="fa-solid fa-user me-2 text-primary"></i>Informations Personnelles
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50">Nom & Prénom :</th>
                                <td class="fw-bold"><%= employee.nom %> <%= employee.prenom %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Date de Naissance :</th>
                                <td><%= employee.date_naissance ? new Date(employee.date_naissance).toLocaleDateString('fr-FR') : 'N/A' %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">N° Sécurité Sociale :</th>
                                <td><code><%= employee.num_ss || 'N/A' %></code></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Adresse :</th>
                                <td><%= employee.adresse || 'N/A' %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Informations Professionnelles -->
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light fw-bold text-dark border-0">
                    <i class="fa-solid fa-briefcase me-2 text-primary"></i>Informations Professionnelles
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50">Matricule :</th>
                                <td class="fw-bold text-primary"><%= employee.matricule %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Emploi / Poste :</th>
                                <td><%= employee.emploi || 'N/A' %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Section / Atelier :</th>
                                <td><%= employee.section_atelier || 'N/A' %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Date d'Entrée :</th>
                                <td><%= employee.date_entree ? new Date(employee.date_entree).toLocaleDateString('fr-FR') : 'N/A' %></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Horaire Mensuel :</th>
                                <td><%= employee.horaire_mensuel || 173.33 %> hrs</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Informations Financières & Paiement -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light fw-bold text-dark border-0">
                    <i class="fa-solid fa-money-bill-wave me-2 text-primary"></i>Informations Financières & Paiement
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">Salaire de Base</small>
                            <h5 class="fw-bold text-success mb-0 fs-6 fs-md-5">
                                <%= Number(employee.salaire_de_base || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) %> DZD
                            </h5>
                        </div>
                        <div class="col-6 col-md-3">
                            <small class="text-muted d-block">Mode de Règlement</small>
                            <span class="fw-bold"><%= employee.mode_paiement || 'N/A' %></span>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <small class="text-muted d-block">N° Compte / RIP / CCP</small>
                            <code class="text-break"><%= employee.compte_bancaire || 'N/A' %></code>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3">
                            <small class="text-muted d-block">Banque / SWIFT</small>
                            <span class="text-break"><%= employee.bank_id || 'N/A' %> <%= employee.swift ? '(' + employee.swift + ')' : '' %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>