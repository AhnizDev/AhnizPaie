<%- include('../partials/header') %>

    <div class="container payroll-container">

        <!-- En-tête de page -->
        <div class="header-bar">
            <div class="title-area">
                <h1>Gestion de la Paie</h1>
                <div class="subtitle-meta">
                    <span class="badge-period">Période : <strong>
                            <%= typeof periodeActive !== 'undefined' ? periodeActive : 'Septembre 2026' %>
                        </strong></span>
                    <span class="separator">•</span>
                    <span class="current-date">Aujourd'hui : 17 Septembre 2026</span>
                </div>
            </div>

            <!-- Actions de la page -->
            <div class="actions-area">
                <a href="/payroll/pointage" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Saisie du Pointage
                </a>

                <a href="/payroll/historique" class="btn btn-info text-white">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8v4l3 3"></path>
                        <circle cx="12" cy="12" r="9"></circle>
                    </svg>
                    Historique
                </a>

                <form action="/payroll/cloturer" method="POST" class="d-inline"
                    onsubmit="return confirm('Attention : Voulez-vous vraiment clôturer ce mois ? Cette action va archiver les bulletins et basculer vers le mois suivant.');">
                    <button type="submit" class="btn btn-danger">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Clôturer le Mois
                    </button>
                </form>

                <a href="/dashboard" class="btn btn-secondary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Tableau de Bord
                </a>
            </div>
        </div>

        <!-- Cartes Statistiques -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon employees-icon">👥</div>
                <div>
                    <div class="title">Total Salariés</div>
                    <div class="value">
                        <%= typeof employees !== 'undefined' ? employees.length : 0 %>
                    </div>
                </div>
            </div>
            <div class="stat-card brut-card">
                <div class="stat-icon brut-icon">📊</div>
                <div>
                    <div class="title">Masse Salariale Brute / Imposable</div>
                    <div class="value">
                        <%= typeof totalBrut !== 'undefined' ? totalBrut : '0,00' %> <small>DZD</small>
                    </div>
                </div>
            </div>
            <div class="stat-card net-card">
                <div class="stat-icon net-icon">💳</div>
                <div>
                    <div class="title">Total Net à Payer</div>
                    <div class="value">
                        <%= typeof totalNet !== 'undefined' ? totalNet : '0,00' %> <small>DZD</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau principal -->
        <div class="card payroll-card">
            <div class="card-header">
                <h3>Liste des Bulletins Générés</h3>
                <span class="badge-count">
                    <%= typeof employees !== 'undefined' ? employees.length : 0 %> Salariés actifs
                </span>
            </div>

            <div class="table-responsive">
                <table class="responsive-table">
                    <thead>
                        <tr>
                            <th>Matricule</th>
                            <th>Nom & Prénom</th>
                            <th>Fonction</th>
                            <th class="num">Salaire Base</th>
                            <th class="num">Net à Payer</th>
                            <th class="center">Statut</th>
                            <th class="center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof employees !== 'undefined' && employees.length > 0) { %>
                            <% employees.forEach(emp => { %>
                                <tr>
                                    <td data-label="Matricule">
                                        <span class="matricule-badge">
                                            <%= emp.matricule %>
                                        </span>
                                    </td>
                                    <td data-label="Nom & Prénom" class="fw-bold">
                                        <%= emp.nom %> <%= emp.prenom %>
                                    </td>
                                    <td data-label="Fonction" class="text-muted">
                                        <%= emp.fonction || emp.emploi || 'Employé(e)' %>
                                    </td>
                                    <td data-label="Salaire Base" class="num">
                                        <%= Number(emp.salaire_de_base || emp.salaire_base || 0).toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> DZD
                                    </td>
                                    <td data-label="Net à Payer" class="num text-highlight">
                                        <strong>
                                            <%= Number(emp.net_a_payer || 0).toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %> DZD
                                        </strong>
                                    </td>
                                    <td data-label="Statut" class="center">
                                        <span class="badge badge-success">Calculé</span>
                                    </td>
                                    <td data-label="Actions" class="center">
                                        <a href="/payroll/bulletin/<%= emp.id %>" class="btn btn-sm btn-primary btn-block-mobile">
                                            Voir Bulletin
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="center text-muted py-4">Aucun employé trouvé</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --info: #0dcaf0;
            --success: #059669;
            --warning: #d97706;
            --danger: #dc2626;
            --danger-dark: #b91c1c;
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .payroll-container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 15px;
        }

        .header-bar {
            background: var(--card-bg);
            padding: 20px 24px;
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .title-area h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
        }

        .subtitle-meta {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--text-muted);
            flex-wrap: wrap;
        }

        .badge-period {
            background: #e0f2fe;
            color: #0369a1;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 500;
        }

        .actions-area {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            padding: 9px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            border: none;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .btn-primary { background: var(--primary); color: #fff; }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-info { background: #0284c7; color: #fff; }
        .btn-info:hover { background: #0369a1; }
        .btn-secondary { background: #475569; color: #fff; }
        .btn-secondary:hover { background: #334155; }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-danger:hover { background: var(--danger-dark); }
        .btn-sm { padding: 6px 12px; font-size: 12px; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 16px;
            border-left: 5px solid var(--primary);
        }

        .stat-card.brut-card { border-left-color: var(--success); }
        .stat-card.net-card { border-left-color: var(--warning); }

        .stat-icon {
            font-size: 28px;
            background: #f1f5f9;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
        }

        .stat-card .title {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
        }

        .stat-card .value {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
            margin-top: 4px;
        }

        .payroll-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            padding: 24px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 15px;
        }

        table.responsive-table {
            width: 100%;
            border-collapse: collapse;
        }

        table.responsive-table th,
        table.responsive-table td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
            font-size: 13px;
        }

        table.responsive-table th {
            background: #f8fafc;
            font-size: 11px;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 700;
        }

        .num { text-align: right; }
        .center { text-align: center; }
        .fw-bold { font-weight: 600; }
        .text-muted { color: var(--text-muted); }
        .text-highlight { color: var(--primary); }

        .matricule-badge {
            background: #e2e8f0;
            padding: 4px 8px;
            border-radius: 6px;
            font-family: monospace;
            font-weight: 600;
            font-size: 12px;
        }

        .badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }
        .badge-success { background: #d1fae5; color: #065f46; }

        @media (max-width: 768px) {
            .header-bar { flex-direction: column; align-items: stretch; text-align: center; }
            .actions-area { justify-content: center; flex-direction: column; }
            .actions-area .btn, .actions-area form, .actions-area button { width: 100%; }
            table.responsive-table thead { display: none; }
            table.responsive-table, table.responsive-table tbody, table.responsive-table tr, table.responsive-table td { display: block; width: 100%; }
            table.responsive-table tr { background: #fff; border: 1px solid var(--border-color); border-radius: 10px; margin-bottom: 15px; padding: 10px 15px; }
            table.responsive-table td { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f1f5f9; text-align: right !important; }
            table.responsive-table td::before { content: attr(data-label); font-weight: 700; text-transform: uppercase; font-size: 11px; color: var(--text-muted); text-align: left; }
        }
    </style>

<%- include('../partials/footer') %>