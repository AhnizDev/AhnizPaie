<%- include('../partials/header') %>

<main class="container-fluid my-4 px-md-4 flex-grow-1">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Bulletins de Paie
            </h2>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary fs-6">Période : <%= periode %></span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <!-- Formulaire pour recalculer tous les bulletins du mois -->
            <form action="/bulletins/generate-all" method="POST" onsubmit="return confirm('Voulez-vous calculer/recalculer la paie de tous les salariés pour la période <%= periode %> ?');">
                <input type="hidden" name="periode" value="<%= periode %>">
                <button type="submit" class="btn btn-success btn-sm shadow-sm">
                    <i class="fa-solid fa-calculator me-1"></i> Calculer Paie Globale
                </button>
            </form>
            <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Tableau de bord
            </a>
        </div>
    </div>

    <!-- Filtre Période -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <form method="GET" action="/bulletins" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label for="periode" class="col-form-label fw-bold">Sélectionner la période :</label>
                </div>
                <div class="col-auto">
                    <input type="month" id="periode" name="periode" value="<%= periode %>" class="form-control form-control-sm">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-filter me-1"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau des bulletins -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="px-3">Matricule</th>
                            <th>Nom & Prénom</th>
                            <th>Fonction</th>
                            <th class="text-end">Base (DA)</th>
                            <th class="text-end">Cotisable (DA)</th>
                            <th class="text-end">Retenues (DA)</th>
                            <th class="text-end">Net à Payer (DA)</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (bulletins && bulletins.length > 0) { %>
                            <% bulletins.forEach(b => { %>
                                <tr>
                                    <td class="px-3 fw-bold text-primary"><%= b.matricule %></td>
                                    <td class="fw-semibold text-dark"><%= b.nom %> <%= b.prenom %></td>
                                    <td><%= b.fonction || '-' %></td>
                                    <td class="text-end"><%= Number(b.salaire_base).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(b.base_cotisable).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end text-danger"><%= Number(b.total_retenues).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end fw-bold text-success fs-6"><%= Number(b.net_a_payer).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-center">
                                        <a href="/bulletins/voir/<%= b.id %>" class="btn btn-outline-primary btn-sm">
                                            <i class="fa-solid fa-eye me-1"></i> Voir / Imprimer
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-circle-info me-2"></i>Aucun bulletin généré pour la période <strong><%= periode %></strong>. Cliquez sur <strong>Calculer Paie Globale</strong>.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>