<%- include('../partials/header') %>

<style>
/* Style spécifique pour l'impression du bulletin */
@media print {
    .no-print {
        display: none !important;
    }
    body {
        background-color: #fff !important;
        font-size: 12px;
    }
    .card {
        border: 1px solid #000 !important;
        box-shadow: none !important;
    }
    .table-bordered th, .table-bordered td {
        border: 1px solid #000 !important;
    }
    .container-fluid {
        padding: 0 !important;
        margin: 0 !important;
    }
}
</style>

<main class="container-fluid my-4 px-md-4 flex-grow-1">
    <!-- Barre d'actions (Masquée à l'impression) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="fa-solid fa-file-invoice me-2 text-primary"></i>Bulletin de Paie
            </h2>
            <span class="badge bg-secondary">Période : <%= bulletin.periode %></span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-primary btn-sm shadow-sm">
                <i class="fa-solid fa-print me-1"></i> Imprimer le Bulletin
            </button>
            <a href="/bulletins?periode=<%= bulletin.periode %>" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>

    <!-- Fiche Bulletin de Paie -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        
        <!-- En-tête Société & Titre -->
        <div class="row border-bottom pb-3 mb-3 align-items-center">
            <div class="col-6">
                <h4 class="fw-bold text-uppercase mb-1" style="color: #1e293b;">AhnizPaie Corp</h4>
                <p class="text-muted small mb-0">Système de Gestion de la Paie & RH</p>
            </div>
            <div class="col-6 text-end">
                <h3 class="fw-bold text-primary mb-0">BULLETIN DE PAIE</h3>
                <span class="fw-semibold text-dark">Période : <%= bulletin.periode %></span>
            </div>
        </div>

        <!-- Informations Employé -->
        <div class="card bg-light border mb-4">
            <div class="card-body py-2">
                <div class="row g-2 small">
                    <div class="col-md-3 col-6">
                        <span class="text-muted d-block">Matricule :</span>
                        <strong class="text-primary"><%= bulletin.matricule %></strong>
                    </div>
                    <div class="col-md-3 col-6">
                        <span class="text-muted d-block">Nom & Prénom :</span>
                        <strong><%= bulletin.nom %> <%= bulletin.prenom %></strong>
                    </div>
                    <div class="col-md-3 col-6">
                        <span class="text-muted d-block">Fonction :</span>
                        <strong><%= bulletin.fonction || '-' %></strong>
                    </div>
                    <div class="col-md-3 col-6">
                        <span class="text-muted d-block">N° Sécurité Sociale (CNAS) :</span>
                        <strong><%= bulletin.num_cnas || '-' %></strong>
                    </div>
                    <div class="col-md-3 col-6">
                        <span class="text-muted d-block">Date d'embauche :</span>
                        <strong>
                            <%= bulletin.date_embauche ? new Date(bulletin.date_embauche).toLocaleDateString('fr-FR') : '-' %>
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau des Rubriques (Lignes de Paie) -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0 text-sm">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Code</th>
                        <th>Libellé Rubrique</th>
                        <th class="text-end" style="width: 120px;">Base (DA)</th>
                        <th class="text-end" style="width: 80px;">Taux %</th>
                        <th class="text-end" style="width: 130px;">Gains (DA)</th>
                        <th class="text-end" style="width: 130px;">Retenues (DA)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (lignes && lignes.length > 0) { %>
                        <% lignes.forEach(l => { %>
                            <tr>
                                <td class="fw-bold text-center"><%= l.code %></td>
                                <td><%= l.libelle %></td>
                                <td class="text-end"><%= l.base ? Number(l.base).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) : '-' %></td>
                                <td class="text-end"><%= l.taux ? Number(l.taux).toFixed(2) : '-' %></td>
                                <td class="text-end fw-semibold <%= l.type_rubrique === 'gain' ? 'text-dark' : '' %>">
                                    <%= l.type_rubrique === 'gain' ? Number(l.montant).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) : '' %>
                                </td>
                                <td class="text-end fw-semibold <%= l.type_rubrique === 'retenue' ? 'text-danger' : '' %>">
                                    <%= l.type_rubrique === 'retenue' ? Number(l.montant).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) : '' %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted">Aucune ligne enregistrée.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Récapitulatif et Totaux -->
        <div class="row g-3 align-items-stretch mb-4">
            <div class="col-md-7">
                <div class="border rounded p-3 h-100 bg-light">
                    <h6 class="fw-bold border-bottom pb-2 mb-2">Bases de calcul</h6>
                    <div class="row text-center">
                        <div class="col-4 border-end">
                            <span class="text-muted small d-block">Salaire de Base</span>
                            <strong class="fs-6"><%= Number(bulletin.salaire_base).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></strong>
                        </div>
                        <div class="col-4 border-end">
                            <span class="text-muted small d-block">Base Cotisable</span>
                            <strong class="fs-6"><%= Number(bulletin.base_cotisable).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></strong>
                        </div>
                        <div class="col-4">
                            <span class="text-muted small d-block">Total Gains</span>
                            <strong class="fs-6"><%= Number(bulletin.total_gains).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %></strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="border rounded p-3 h-100 bg-primary text-white d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>Total Retenues :</span>
                        <strong class="fs-6"><%= Number(bulletin.total_retenues).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %> DA</strong>
                    </div>
                    <hr class="my-2 border-white opacity-50">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">NET À PAYER :</span>
                        <strong class="fs-4 bg-white text-primary px-2 py-1 rounded"><%= Number(bulletin.net_a_payer).toLocaleString('fr-DZ', { minimumFractionDigits: 2 }) %> DA</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Zone de Signatures -->
        <div class="row mt-4 pt-3 border-top text-center small">
            <div class="col-6">
                <p class="fw-bold mb-5">Signature de l'Employé</p>
                <p class="text-muted">Mention "Lu et approuvé"</p>
            </div>
            <div class="col-6">
                <p class="fw-bold mb-5">Cachet et Signature de l'Employeur</p>
                <p class="text-muted">AhnizPaie Management</p>
            </div>
        </div>

    </div>
</main>

<%- include('../partials/footer') %>